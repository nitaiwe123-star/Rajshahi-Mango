{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile information",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "name": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "user"] },
        "phone": { "type": "string" },
        "address": { "type": "string" },
        "emailVerified": { "type": "boolean" }
      },
      "required": ["uid", "email", "role"]
    },
    "Product": {
      "title": "Product",
      "description": "Mango product details",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "regularPrice": { "type": "number" },
        "discountPrice": { "type": "number" },
        "stock": { "type": "number" },
        "images": { "type": "array", "items": { "type": "string" } },
        "weightOptions": { "type": "array", "items": { "type": "number" } },
        "videoUrl": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] }
      },
      "required": ["name", "regularPrice", "stock"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order details",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerPhone": { "type": "string" },
        "customerAddress": { "type": "string" },
        "items": { "type": "array" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "processing", "shipped", "delivered", "cancelled"] },
        "paymentMethod": { "type": "string", "enum": ["COD", "bkash", "nagad", "rocket"] },
        "paymentStatus": { "type": "string", "enum": ["pending", "paid", "failed"] },
        "deliveryArea": { "type": "string" },
        "deliveryCharge": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["customerName", "customerPhone", "customerAddress", "items", "total", "status", "paymentMethod"]
    },
    "Review": {
      "title": "Review",
      "description": "Customer product reviews",
      "type": "object",
      "properties": {
        "productId": { "type": "string" },
        "userId": { "type": "string" },
        "userName": { "type": "string" },
        "userLocation": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["pending", "approved"] }
      },
      "required": ["productId", "rating", "comment", "status"]
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupons",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "discountType": { "type": "string", "enum": ["percentage", "fixed"] },
        "value": { "type": "number" },
        "expiryDate": { "type": "string", "format": "date-time" },
        "usageLimit": { "type": "number" },
        "usedCount": { "type": "number" }
      },
      "required": ["code", "discountType", "value"]
    },
    "Setting": {
      "title": "Setting",
      "description": "Site-wide settings",
      "type": "object",
      "properties": {
        "key": { "type": "string" },
        "value": { "type": "any" }
      },
      "required": ["key", "value"]
    },
    "Banner": {
      "title": "Banner",
      "description": "Marketing banners and sliders",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "image": { "type": "string" },
        "type": { "type": "string", "enum": ["slider", "offer"] },
        "order": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "image", "type"]
    },
    "Category": {
      "title": "Category",
      "description": "Product categories",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "image": { "type": "string" },
        "slug": { "type": "string" }
      },
      "required": ["name", "image"]
    },
    "Log": {
      "title": "Log",
      "description": "System activity logs",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "message": { "type": "string" },
        "time": { "type": "string", "format": "date-time" }
      },
      "required": ["type", "message", "time"]
    }
  },
  "firestore": {
    "users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "products/{productId}": {
      "schema": "Product",
      "description": "Product catalog"
    },
    "orders/{orderId}": {
      "schema": "Order",
      "description": "Order records"
    },
    "reviews/{reviewId}": {
      "schema": "Review",
      "description": "Product reviews"
    },
    "coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Discount coupons"
    },
    "settings/{settingId}": {
      "schema": "Setting",
      "description": "App settings"
    },
    "admins/{userId}": {
      "schema": "User",
      "description": "Admin users"
    },
    "banners/{bannerId}": {
      "schema": "Banner",
      "description": "Site banners"
    },
    "categories/{categoryId}": {
      "schema": "Category",
      "description": "Product categories"
    },
    "logs/{logId}": {
      "schema": "Log",
      "description": "Activity logs"
    }
  }
}
