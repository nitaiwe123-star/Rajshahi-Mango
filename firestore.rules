rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Global helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "nitaiwe123@gmail.com" ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity Validations
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'role']) &&
             data.keys().size() <= 15 &&
             data.uid is string && data.uid.size() <= 128 &&
             data.email is string && data.email.size() <= 256 &&
             data.role in ['admin', 'user'];
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'price', 'stock']) &&
             data.keys().size() <= 20 &&
             data.name is string && data.name.size() <= 200 &&
             data.price is number && data.price >= 0 &&
             data.stock is number && data.stock >= 0;
    }

    function isValidOrder(data) {
      return data.keys().hasAll(['customerName', 'customerPhone', 'customerAddress', 'items', 'total', 'status']) &&
             data.keys().size() <= 30 &&
             data.customerName is string && data.customerName.size() <= 100 &&
             data.customerPhone is string && data.customerPhone.size() <= 20 &&
             data.customerAddress is string && data.customerAddress.size() <= 500 &&
             data.items is list && data.items.size() > 0 &&
             data.total is number && data.total >= 0 &&
             data.status is string;
    }

    function isValidBanner(data) {
      return data.keys().hasAll(['title', 'image', 'type']) &&
             data.title is string && data.image is string && data.type in ['slider', 'offer'];
    }

    function isValidCategory(data) {
      return data.keys().hasAll(['name', 'image']) &&
             data.name is string && data.image is string;
    }

    function isValidLog(data) {
      return data.keys().hasAll(['type', 'message', 'time']) &&
             data.type is string && data.message is string && data.time is string;
    }

    // Rules for each collection
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId && isValidUser(incoming());
      allow update: if isSignedIn() && (request.auth.uid == userId || isAdmin()) &&
                    isValidUser(incoming()) &&
                    incoming().uid == existing().uid &&
                    (isAdmin() || !incoming().diff(existing()).affectedKeys().hasAny(['role']));
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin() && isValidProduct(incoming());
    }

    match /orders/{orderId} {
      allow get: if (resource.data.userId == request.auth.uid || isAdmin()) || (!isSignedIn() && !resource.data.keys().hasAny(['userId']));
      allow list: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if isValidOrder(incoming()) && (
        (isSignedIn() && incoming().userId == request.auth.uid) ||
        (!isSignedIn() && !incoming().keys().hasAny(['userId'])) ||
        (isSignedIn())
      );
      allow update: if isAdmin() && isValidOrder(incoming());
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    match /coupons/{couponId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin() && isValidBanner(incoming());
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin() && isValidCategory(incoming());
    }

    match /logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidLog(incoming());
    }

    match /admins/{userId} {
      allow get: if isSignedIn();
      allow list: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
